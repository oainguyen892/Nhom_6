@* Phân công phụ trách (chưa xác nhận tác giả thực hiện).
Họ và tên: Nguyễn Văn Phong
Mã sinh viên: 23203100062
Nội dung thực hiện: Phạm vi được giao - Module 4: quản lý phiếu, xác nhận/hủy và nhận/trả phòng.
Trạng thái: chờ thành viên trực tiếp review, chỉnh sửa và xác nhận.
*@
@model List<PhieuDatPhong>
<div class="table-wrap"><table><thead><tr><th>Phiếu</th>@if(ViewContext.RouteData.Values["controller"]?.ToString()=="PhieuDatPhong"){<th>Khách hàng</th>}<th>Ngày nhận</th><th>Ngày trả</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><a asp-action="Details" asp-route-id="@p.MaPhieuDat">#@p.MaPhieuDat</a></td>@if(ViewContext.RouteData.Values["controller"]?.ToString()=="PhieuDatPhong"){<td>@p.KhachHang.HoTen</td>}<td>@p.NgayNhanDuKien.ToString("dd/MM/yyyy")</td><td>@p.NgayTraDuKien.ToString("dd/MM/yyyy")</td><td>@p.TongTienDuKien.Vnd()</td><td><span class="badge">@p.TrangThai.Ten()</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có phiếu đặt phòng phù hợp.</p>}
