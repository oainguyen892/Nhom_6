@* Giao diện danh sách phòng, bộ lọc giữ lại toàn bộ tham số khi phân trang. *@
@model PhongPage
@{ ViewData["Title"] = "Danh sách phòng"; var f = Model.Query; var role = Context.Session.GetString("VaiTro"); var canManage = role is "Admin" or "QuanLy"; }
<div class="toolbar"><div><p class="eyebrow">Chọn không gian của bạn</p><h1>Danh sách phòng</h1><span class="muted">@Model.Total phòng phù hợp</span></div>@if(canManage){<a class="button" asp-action="Create">Thêm phòng</a>}</div>
<form method="get" class="panel"><div asp-validation-summary="All"></div><div class="filters">
<div><label for="Q">Số phòng / tên loại</label><input id="Q" name="Q" value="@f.Q" maxlength="100"/></div><div><label for="Toa">Tòa</label><input id="Toa" name="Toa" value="@f.Toa" maxlength="30" placeholder="Ví dụ: A"/></div>
<div><label for="Loai">Loại phòng</label><select id="Loai" name="Loai"><option value="">Tất cả</option>@foreach(var l in Model.Loais){<option value="@l.MaLoaiPhong" selected="@(l.MaLoaiPhong == f.Loai ? "selected" : null)">@l.TenLoaiPhong</option>}</select></div>
<div><label for="Tang">Tầng</label><input id="Tang" name="Tang" type="number" min="1" max="15" value="@f.Tang"/></div>
<div><label for="TrangThai">Trạng thái</label><select id="TrangThai" name="TrangThai"><option value="">Tất cả</option>@foreach(var s in Enum.GetValues<TrangThaiPhong>()){<option value="@((int)s)" selected="@(s == f.TrangThai ? "selected" : null)">@s.Ten()</option>}</select></div>
<div><label for="GiaTu">Giá từ (VND)</label><input id="GiaTu" type="number" name="GiaTu" min="0" step="0.01" value="@(f.GiaTu?.ToString(System.Globalization.CultureInfo.InvariantCulture))"/></div><div><label for="GiaDen">Giá đến (VND)</label><input id="GiaDen" type="number" name="GiaDen" min="0" step="0.01" value="@(f.GiaDen?.ToString(System.Globalization.CultureInfo.InvariantCulture))"/></div>
<div><label for="Sort">Sắp xếp</label><select name="Sort" id="Sort">@foreach(var s in new[]{("so","Số phòng ↑"),("so_desc","Số phòng ↓"),("gia","Giá ↑"),("gia_desc","Giá ↓"),("tang","Tầng ↑"),("tang_desc","Tầng ↓")}){<option value="@s.Item1" selected="@(s.Item1 == f.Sort ? "selected" : null)">@s.Item2</option>}</select></div><button>Tìm phòng</button></div><a asp-action="Index">Xóa bộ lọc</a></form>
<div class="grid room-grid">@foreach(var x in Model.Items){<article class="card room-card"><a class="room-card-image" asp-action="Details" asp-route-id="@x.MaPhong"><img src="@RoomIllustrations.For(x.LoaiPhong.TenLoaiPhong)" alt="Ảnh minh họa hạng @x.LoaiPhong.TenLoaiPhong của phòng @x.SoPhong" width="1536" height="1024" loading="lazy" decoding="async"/><span class="image-label">Ảnh minh họa</span></a><div class="room-card-body"><div class="room-no">@x.SoPhong</div><h2>@x.LoaiPhong.TenLoaiPhong</h2><p class="muted">Tòa @x.Toa · Tầng @x.Tang · Tối đa @x.LoaiPhong.SoNguoiToiDa người</p><span class="badge">@(x.LoaiPhong.TrangThai ? x.TrangThai.Ten() : "Loại phòng tạm ngừng")</span><p class="price">@x.DonGiaDem.Vnd()<small> / đêm</small></p><div class="actions"><a class="button" asp-action="Details" asp-route-id="@x.MaPhong">Xem phòng</a>@if(canManage){<a asp-action="Edit" asp-route-id="@x.MaPhong">Sửa</a><form asp-action="Delete" asp-route-id="@x.MaPhong" method="post" onsubmit="return confirm('Xóa phòng này?')"><button class="danger">Xóa</button></form>}</div></div></article>}</div>
@if(Model.Total == 0){<div class="empty">Không tìm thấy phòng phù hợp. Hãy thử thay đổi bộ lọc.</div>}
<nav class="pager" aria-label="Phân trang"><span>Trang @f.Page / @Model.Pages</span>
@{var pages = new SortedSet<int>{1,Model.Pages}; for(var n=Math.Max(1,f.Page-2); n<=Math.Min(Model.Pages,f.Page+2); n++) pages.Add(n);}
@if(f.Page > 1){<a asp-action="Index" asp-all-route-data="@Routes(f,f.Page-1)">← Trước</a>}
@foreach(var n in pages){if(n == f.Page){<strong aria-current="page">@n</strong>}else{<a asp-action="Index" asp-all-route-data="@Routes(f,n)">@n</a>}}
@if(f.Page < Model.Pages){<a asp-action="Index" asp-all-route-data="@Routes(f,f.Page+1)">Sau →</a>}</nav>
@functions{Dictionary<string,string> Routes(PhongQuery q,int page) => new(){["Q"] = q.Q ?? "", ["Loai"] = q.Loai?.ToString() ?? "", ["Toa"] = q.Toa ?? "", ["Tang"] = q.Tang?.ToString() ?? "", ["TrangThai"] = q.TrangThai?.ToString() ?? "", ["GiaTu"] = q.GiaTu?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "", ["GiaDen"] = q.GiaDen?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "", ["Sort"] = q.Sort, ["Page"] = page.ToString()};}
