@model List<PhieuDatPhong>
@{ ViewData["Title"] = "Quản lý phiếu đặt"; }
<h1>Quản lý phiếu đặt</h1><form method="get" class="panel filters"><div><label for="q">Mã đặt / khách hàng / phòng</label><input id="q" name="q" value="@ViewBag.Q"/></div><div><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai"><option value="">Tất cả</option>@foreach(var s in Enum.GetValues<TrangThaiDat>()){<option value="@((int)s)" selected="@((TrangThaiDat?)ViewBag.TrangThai == s ? "selected" : null)">@s.Ten()</option>}</select></div><div><label for="ngayNhan">Ngày nhận</label><input type="date" id="ngayNhan" name="ngayNhan" value="@(((DateTime?)ViewBag.NgayNhan)?.ToString("yyyy-MM-dd"))"/></div><button>Tìm phiếu</button></form><partial name="_BookingList" model="Model"/>
