@model List<PhieuDatPhong>
<div class="table-wrap"><table><thead><tr><th>Mã đặt</th>@if(ViewContext.RouteData.Values["controller"]?.ToString()=="PhieuDatPhong"){<th>Khách hàng</th>}<th>Ngày nhận</th><th>Ngày trả</th><th>Khách</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><span>@p.MaDatPhong</span> <a asp-action="Details" asp-route-id="@p.MaPhieuDat">#@p.MaPhieuDat</a></td>@if(ViewContext.RouteData.Values["controller"]?.ToString()=="PhieuDatPhong"){<td>@p.KhachHang.HoTen</td>}<td>@p.NgayNhanDuKien.ToString("dd/MM/yyyy")</td><td>@p.NgayTraDuKien.ToString("dd/MM/yyyy")</td><td>@p.SoNguoi</td><td>@p.TongTienDuKien.Vnd()</td><td>@p.TrangThaiThanhToan.Ten()</td><td><span class="badge">@p.TrangThai.Ten()</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có phiếu đặt phòng phù hợp.</p>}
