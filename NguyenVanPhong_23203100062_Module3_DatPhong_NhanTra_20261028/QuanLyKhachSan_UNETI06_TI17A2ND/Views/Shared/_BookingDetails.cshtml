@model PhieuDatPhong
<div class="toolbar"><h1>Phiếu đặt @Model.MaDatPhong</h1><span class="badge">@Model.TrangThai.Ten()</span></div>
<div class="panel"><dl><dt>Mã đặt phòng</dt><dd><strong>@Model.MaDatPhong</strong></dd><dt>Ngày đặt</dt><dd>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</dd><dt>Ngày nhận dự kiến</dt><dd>@Model.NgayNhanDuKien.ToString("dd/MM/yyyy")</dd><dt>Ngày trả dự kiến</dt><dd>@Model.NgayTraDuKien.ToString("dd/MM/yyyy")</dd><dt>Nhận phòng thực tế</dt><dd>@(Model.NgayNhanPhongThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa nhận")</dd><dt>Trả phòng thực tế</dt><dd>@(Model.NgayTraPhongThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa trả")</dd><dt>Số người</dt><dd>@Model.SoNguoi</dd><dt>Tổng dự kiến</dt><dd class="price">@Model.TongTienDuKien.Vnd()</dd><dt>Tiền cọc dự kiến</dt><dd>@Model.TienCoc.Vnd()</dd><dt>Thanh toán</dt><dd>@Model.TrangThaiThanhToan.Ten() · @Model.DaThanhToan.Vnd() · Còn lại: @((Model.TongTienDuKien-Model.DaThanhToan).Vnd())</dd></dl><p><a asp-controller="ThanhToan" asp-action="Quet" asp-route-token="@Model.MaQr">Mở mã QR thanh toán</a></p><img src="@Url.Action("Qr", "ThanhToan", new { id = Model.MaPhieuDat })" alt="Mã QR của phiếu @Model.MaDatPhong" width="180" height="180"/></div>
<div class="table-wrap"><table><thead><tr><th>Phòng</th><th>Giá cơ bản</th><th>Số đêm</th><th>Thành tiền theo ngày</th></tr></thead><tbody>@foreach(var d in Model.ChiTiets){<tr><td>Tòa @d.Phong.Toa · @d.Phong.SoPhong</td><td>@d.DonGiaDem.Vnd()</td><td>@d.SoDem</td><td>@d.ThanhTien.Vnd()</td></tr>}</tbody></table></div><p class="muted">Giá ngày thường theo bảng giá; cuối tuần tăng 15%; ngày lễ tăng 30%. Giá được chốt tại thời điểm đặt.</p>
@if (Model.TrangThai == TrangThaiDat.DaTraPhong && Model.DanhGia is null && Context.Session.GetString("VaiTro") == "KhachHang") { <section class="panel"><h2>Đánh giá dịch vụ</h2><form asp-controller="ChamSocKhachHang" asp-action="DanhGia" method="post"><input name="Id" type="hidden" value="@Model.MaPhieuDat"/><label for="SoSao">Mức độ hài lòng</label><select id="SoSao" name="SoSao">@for(var i=5;i>=1;i--){<option value="@i">@i sao</option>}</select><label for="NoiDung">Nhận xét</label><textarea id="NoiDung" name="NoiDung"></textarea><button>Gửi đánh giá</button></form></section> } else if (Model.DanhGia is not null) { <p>Đánh giá: @Model.DanhGia.SoSao/5 sao · @Model.DanhGia.NoiDung</p> }
