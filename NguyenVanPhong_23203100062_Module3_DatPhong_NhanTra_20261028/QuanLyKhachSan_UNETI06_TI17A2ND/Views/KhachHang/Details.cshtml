@model KhachHang
@{ ViewData["Title"] = "Chi tiết khách hàng"; }
<section class="panel"><h1>@Model.HoTen</h1><dl><dt>Ngày sinh</dt><dd>@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd><dt>Giới tính</dt><dd>@Model.GioiTinh</dd><dt>Điện thoại</dt><dd>@Model.SoDienThoai</dd><dt>Email</dt><dd>@Model.Email</dd><dt>CCCD</dt><dd>@Model.CCCD</dd><dt>Địa chỉ</dt><dd>@Model.DiaChi</dd><dt>Ngày đăng ký</dt><dd>@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd><dt>Hạng thành viên</dt><dd>@Model.HangThanhVien.Ten()</dd><dt>Số phiếu đã đặt</dt><dd>@Model.PhieuDats.Count</dd><dt>Trạng thái</dt><dd>@(Model.TrangThai ? "Hoạt động" : "Khóa đặt phòng")</dd></dl><a asp-action="Index">Danh sách khách hàng</a></section>
